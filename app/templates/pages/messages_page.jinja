{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}

{% block content %}
<h2>Messages</h2>

{% for message in messages %}

    <div class="message">
        <h3>{{ message["pet name"] }}</h3>
        <p>{{ message["pet type"] }}</p>
        <p>{{ message["breed"] }}</p>
        <p>{{ message["location"] }}</p>
        <p>{{ message["date lost"] }}</p>
        <p>{{ message["description"] }}</p>
    </div>

{% else %}

    <p>No pets have been reported yet.</p>

{% endfor %}
</div>
    </section>
{% endblock %}

