{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}

{% block content %}
<h2>Messages</h2>

{% for message in messages %}

    <div class="message">
        <h3>{{ message["title"] }}</h3>

        <p>{{ message["body"] }}</p>

        <p>Category: {{ message["tags"] }}</p>
    </div>

{% else %}

    <p>No pets have been reported yet.</p>

{% endfor %}
</div>
    </section>
{% endblock %}

