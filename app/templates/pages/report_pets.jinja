{#=====================================================
  Home page
=====================================================#}
{% extends 'pages/_base.jinja' %}

{% block content %}     
<form method="post" action="/report/pet">
    <h3>New Note</h3>

    <label>
        pet name
        <input name="pet_name" type="text" placeholder="e.g. jack" required>
    </label>

    <label>
        pet type
        <input name="pet_type" placeholder="e.g. dog, cat, parrot" required>
    </label> 

    <label>
        gender

        <select name="gender" required>
            <option>Male</option>
            <option>Female</option>
            <option>Unknown</option>
        </select>
    </label>

    <label>
        description
        <textarea name="description"  placeholder="Decribe your pet..." required></textarea>
    </label>

    <label>
        date lost
        <input name="date_lost" type="date" max="{{ today }}"required></textarea>
    </label>

    <label>
        location last seen
        <textarea name="location" placeholder="Describe where your saw them last..." required></textarea>
    </label>

    <button>send details</button>
</form>

{% endblock %}
